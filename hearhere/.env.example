DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="请替换为随机长字符串"

# ── LLM 配置（二选一，优先 DeepSeek）──────────────────

# DeepSeek API（推荐）
DEEPSEEK_API_KEY="请替换为您的 DeepSeek API Key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_CHAT_MODEL="deepseek-chat"

# 硅基流动 API（备选，DeepSeek 未配置时使用）
SILICONFLOW_API_KEY="请替换为您的硅基流动 API Key"
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_CHAT_MODEL="Qwen/Qwen2.5-32B-Instruct"
SILICONFLOW_ASR_MODEL="FunAudioLLM/SenseVoiceSmall"

# Tavily 搜索 API 配置
TAVILY_API_KEY="请替换为您的 Tavily API Key"

# 数据源配置: mock | tavily | crawler
INSIGHT_SOURCE="tavily"
